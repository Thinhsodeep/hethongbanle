# Sao chép thành .env (không commit .env)
# Hoặc điền GROQ_API_KEY trong .env hoặc config/constants.php (local only)

# Groq — https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GROQ_TIMEOUT=30

# Giới hạn import (số dòng Excel)
IMPORT_MAX_ROWS=500

# Ghi debug_import_*.txt khi true
IMPORT_DEBUG=false
